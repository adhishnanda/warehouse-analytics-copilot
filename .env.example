# Ollama — local dev backend, no key needed if running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Week 2 LLM evaluation (Section 7.3): Groq free tier + one small paid model.
# Paid calls are flagged before use, never made for routine development.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DuckDB warehouse path
DUCKDB_PATH=data/warehouse.duckdb

# Week 3 interface (src/app/api.py)
# AGENT_CHAT_BACKEND: "ollama" (default, free) or "openai" (the Day 11
# production winner, paid — see PROJECT_PLAN.md Section 5.5).
AGENT_CHAT_BACKEND=ollama
TRACE_LOG_PATH=data/telemetry/traces.jsonl

# Only enforced when AGENT_CHAT_BACKEND=openai (e.g. the public Render
# deploy) — bounds per-day paid-backend queries. No effect on the free
# Ollama backend.
MAX_DAILY_QUERIES=50
