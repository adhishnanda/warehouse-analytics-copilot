# Ollama — local dev backend, no key needed if running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Week 2 LLM evaluation (Section 7.3): Groq free tier + one small paid model.
# Paid calls are flagged before use, never made for routine development.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DuckDB warehouse path
DUCKDB_PATH=data/warehouse.duckdb
